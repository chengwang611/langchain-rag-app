FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src \
    PORT=8000 \
    REVIEW_VECTOR_BACKEND=file \
    REVIEW_FILE_BACKEND_PATH=/data/fund_chunks.jsonl

WORKDIR /app

# Keep image lean while supporting HTTPS certs and proper PID 1 signal handling.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --upgrade pip \
    && pip install -r requirements.txt \
    && pip install "uvicorn[standard]>=0.30.0" "fastapi>=0.115.0"

COPY src/ ./src/

# Run as non-root for OCP/AKS security policies.
RUN useradd -m -u 10001 appuser \
    && mkdir -p /data \
    && chown -R appuser:appuser /app /data

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"

ENTRYPOINT ["tini", "--"]
CMD ["uvicorn", "capital_market_risk_review.review_process.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
